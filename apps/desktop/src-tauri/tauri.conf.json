{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inferoid",
  "mainBinaryName": "Inferoid",
  "version": "0.7.3",
  "identifier": "ai.inferoid.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Inferoid",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "resources": [
      "binaries/*",
      "config/engine.example.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
